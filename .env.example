# QuickCommerceAPI Integration (Live platform provider)
QUICKCOMMERCE_API_KEY=
QUICKCOMMERCE_API_BASE_URL=https://api.quickcommerceapi.com

# Firebase Client SDK (safe for browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server only — NEVER expose to browser)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Google Maps API Key (optional — for address autocomplete)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Data source mode: 'live' | 'mock' | 'hybrid'
NEXT_PUBLIC_DATA_SOURCE=live
